{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "npm --workspace=@workspace/srma-research-academy run build",
    "build:frontend": "npm --workspace=@workspace/srma-research-academy run build",
    "build:all": "npm --workspaces --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs",
    "test": "npm run typecheck",
    "lint": "tsc --build"
  },
  "dependencies": {
    "@clerk/express": "^2.1.61",
    "@clerk/shared": "^4.29.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "vite": "^7.3.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ]
}
