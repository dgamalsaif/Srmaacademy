# Frontend: public API base URL. Do not place secrets in VITE_* variables.
VITE_API_URL=https://api.example.com

# Frontend deployment base path, if your host serves the app below the domain root.
BASE_PATH=/

# Frontend development port.
PORT=5173

# API server: comma-separated origins permitted to make credentialed browser requests.
FRONTEND_ORIGIN=https://example.com,https://www.example.com

# Clerk configuration. Set actual values only in local .env files or hosting-provider secrets.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key

# Database configuration. Use a non-production value locally; never commit a real URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
