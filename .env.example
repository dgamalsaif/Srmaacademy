# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Cloud SQL) - optional; in-memory fallback is active if unset
DATABASE_URL=

# Clerk Authentication (optional)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Security & Sessions
SESSION_SECRET=srma-development-secret
OWNER_BOOTSTRAP_EMAIL=srmaacademy@gmail.com
OWNER_BOOTSTRAP_SECRET=

# Email / SMTP Notifications (optional)
ADMIN_NOTIFICATION_EMAIL=srmaacademy@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@srmaacademy.com

# Cloudflare R2 / S3 Storage for uploaded images (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Gemini API (optional)
GEMINI_API_KEY=
